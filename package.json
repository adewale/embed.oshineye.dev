{
  "name": "embeds",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:py": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:py",
    "test:e2e": "playwright test",
    "test:e2e:behaviour": "EMBED_BEHAVIOUR_CHECKS=1 playwright test tests/e2e/embed-behaviour.spec.ts",
    "build:github-timeline": "tsx scripts/build-github-timeline.ts",
    "build:blogging-timeline": "tsx scripts/build-blogging-timeline.ts",
    "build:timelines": "tsx scripts/build-github-timeline.ts && tsx scripts/build-blogging-timeline.ts",
    "build:team-architectures": "python3 scripts/build_team_architectures.py && tsx scripts/build-team-svgs.ts",
    "build:user-architectures": "python3 scripts/build_user_architectures.py",
    "postinstall": "node scripts/apply-mermaid-patch.mjs"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@playwright/test": "^1.58.2",
    "beautiful-mermaid": "1.0.2",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
